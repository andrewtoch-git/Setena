# Copia este archivo a .env y rellena los valores. Nunca subas .env al repositorio.

# MongoDB Atlas (cadena de conexión del clúster, con la base de datos al final)
MONGODB_URI=mongodb+srv://USUARIO:CONTRASENA@CLUSTER.mongodb.net/setena

# Secretos JWT: dos cadenas aleatorias distintas de al menos 32 caracteres.
# Genera una con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Vida de los tokens en segundos (acceso 15 min, refresh 30 días)
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

# Orígenes permitidos por CORS, separados por comas (app Ionic en desarrollo y Capacitor)
CORS_ORIGINS=http://localhost:8100,capacitor://localhost,http://localhost

# IDs de cliente OAuth de Google (web y Android), separados por comas. Vacío = login con Google desactivado.
GOOGLE_CLIENT_IDS=

# Límite de peticiones a /auth por IP: THROTTLE_LIMIT peticiones cada THROTTLE_TTL_MS milisegundos
THROTTLE_LIMIT=10
THROTTLE_TTL_MS=60000

PORT=3000
